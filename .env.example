APP_NAME="PROFITLIFE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# La base de datos siempre guarda en UTC; la interfaz muestra la hora en APP_DISPLAY_TIMEZONE.
APP_DISPLAY_TIMEZONE=America/Bogota
APP_LOCALE=es_CO
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_CURRENCY=COP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=profitlife
DB_USERNAME=profitlife
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default

CACHE_STORE=database

# Vigencia en horas del enlace de invitación al staff.
INVITATION_EXPIRES_HOURS=72

# En local se recomienda Mailpit (http://localhost:8025). En producción, SMTP del proveedor.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
